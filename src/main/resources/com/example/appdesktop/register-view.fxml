<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.appdesktop.RegisterController"
           style="-fx-background-color: linear-gradient(to bottom right, #fffbeb, #fff7ed, #fef3c7);">
    <children>
        <VBox alignment="CENTER" maxWidth="640" spacing="16" StackPane.alignment="CENTER">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <VBox alignment="CENTER" spacing="6">
                <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Registo Cliente"/>
                <Label style="-fx-text-fill: #4b5563;" text="Crie a sua conta para aceder ao portal."/>
            </VBox>

            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                <children>
                    <VBox spacing="6">
                        <children>
                            <Label text="Nome da empresa"/>
                            <TextField fx:id="nomeEmpresaField" promptText="Empresa"/>
                        </children>
                    </VBox>

                    <VBox spacing="6">
                        <children>
                            <Label text="NIF"/>
                            <TextField fx:id="nifField" promptText="123456789"/>
                        </children>
                    </VBox>

                    <VBox spacing="6">
                        <children>
                            <Label text="Email"/>
                            <TextField fx:id="emailField" promptText="seu@email.com"/>
                        </children>
                    </VBox>

                    <VBox spacing="6">
                        <children>
                            <Label text="Password"/>
                            <PasswordField fx:id="passwordField" promptText="********"/>
                        </children>
                    </VBox>

                    <VBox spacing="6">
                        <children>
                            <Label text="Telefone (opcional)"/>
                            <TextField fx:id="telefoneField" promptText="912345678"/>
                        </children>
                    </VBox>

                    <VBox spacing="6">
                        <children>
                            <Label text="Morada de faturacao (opcional)"/>
                            <TextArea fx:id="moradaFaturacaoField" prefRowCount="2" promptText="Rua Exemplo, 123" wrapText="true"/>
                        </children>
                    </VBox>

                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <children>
                            <Button fx:id="backButton" mnemonicParsing="false" onAction="#onBackToLogin"
                                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280;" text="Voltar"/>
                            <Button fx:id="registerButton" mnemonicParsing="false" onAction="#onRegister"
                                    style="-fx-background-color: #d97706; -fx-text-fill: white; -fx-font-weight: bold;"
                                    text="Criar conta"/>
                        </children>
                    </HBox>
                </children>
            </VBox>
        </VBox>
    </children>
</StackPane>
