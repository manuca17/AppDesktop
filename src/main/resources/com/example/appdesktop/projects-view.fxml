<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.appdesktop.ProjectsController"
            style="-fx-background: transparent; -fx-background-color: transparent;">
    <content>
        <VBox spacing="16" style="-fx-padding: 4;">
            <HBox>
                <VBox spacing="4">
                    <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Meus Projetos Personalizados"/>
                    <Label style="-fx-text-fill: #4b5563;" text="Acompanhe o desenvolvimento das suas pecas exclusivas"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#onNewProject" style="-fx-background-color: #d97706; -fx-text-fill: white; -fx-font-weight: bold;" text="Novo Projeto"/>
            </HBox>

            <VBox fx:id="projectsContainer" spacing="12"/>
            <Label fx:id="emptyLabel" managed="false" style="-fx-text-fill: #6b7280;" text="Ainda nao tem projetos personalizados" visible="false"/>
        </VBox>
    </content>
</ScrollPane>
