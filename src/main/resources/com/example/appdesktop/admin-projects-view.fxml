<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.appdesktop.AdminProjectsController"
            style="-fx-background: transparent; -fx-background-color: transparent;">
    <content>
        <VBox spacing="16" style="-fx-padding: 4;">
            <VBox spacing="4">
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Gestao de Projetos"/>
                <Label style="-fx-text-fill: #4b5563;" text="Acompanhe e atualize todos os projetos personalizados"/>
            </VBox>

            <HBox spacing="10">
                <TextField fx:id="searchField" onKeyReleased="#onSearchChanged"
                           promptText="Procurar por titulo ou ID..." HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="statusCombo" onAction="#onStatusChanged" prefWidth="200" promptText="Estado"/>
            </HBox>

            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <VBox GridPane.columnIndex="0" spacing="4" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8;">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" text="Total"/>
                    <Label fx:id="totalProjectsLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="0"/>
                </VBox>
                <VBox GridPane.columnIndex="1" spacing="4" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8;">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" text="Em analise"/>
                    <Label fx:id="briefingProjectsLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #92400e;" text="0"/>
                </VBox>
                <VBox GridPane.columnIndex="2" spacing="4" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8;">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" text="Em producao"/>
                    <Label fx:id="productionProjectsLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e40af;" text="0"/>
                </VBox>
                <VBox GridPane.columnIndex="3" spacing="4" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8;">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" text="Concluidos"/>
                    <Label fx:id="completedProjectsLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #5b21b6;" text="0"/>
                </VBox>
            </GridPane>

            <VBox fx:id="projectsContainer" spacing="12"/>
            <Label fx:id="emptyLabel" managed="false" style="-fx-text-fill: #6b7280;" text="Nenhum projeto encontrado" visible="false"/>
        </VBox>
    </content>
</ScrollPane>