<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.appdesktop.BriefingController"
            style="-fx-background: transparent; -fx-background-color: transparent;">
    <content>
        <VBox spacing="16" style="-fx-padding: 4;">
            <VBox spacing="4">
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Novo Briefing"/>
                <Label style="-fx-text-fill: #4b5563;" text="Submeta os detalhes para um novo projeto personalizado"/>
            </VBox>

            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16;">
                <Label text="Nome do Projeto"/>
                <TextField fx:id="titleField" promptText="Ex: Colecao para restaurante"/>

                <Label text="Setor"/>
                <ComboBox fx:id="categoryCombo" promptText="Selecionar setor"/>

                <Label text="Quantidade estimada"/>
                <TextField fx:id="quantityField" promptText="Ex: 120"/>

                <Label text="Descricao"/>
                <TextArea fx:id="descriptionArea" prefRowCount="5" promptText="Descreva objetivo, estilo e uso das pecas"/>

                <Label text="Referencias visuais e observacoes"/>
                <TextArea fx:id="referencesArea" prefRowCount="4" promptText="Cores, acabamentos, links e notas"/>

                <HBox spacing="10">
                    <Button mnemonicParsing="false" onAction="#onClearForm" style="-fx-background-color: transparent; -fx-border-color: #d1d5db;" text="Limpar"/>
                    <Button mnemonicParsing="false" onAction="#onSubmitBriefing" style="-fx-background-color: #d97706; -fx-text-fill: white; -fx-font-weight: bold;" text="Enviar Briefing"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
