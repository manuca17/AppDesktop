<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.appdesktop.ClientLayoutController"
            style="-fx-background-color: #f9fafb;">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0; -fx-padding: 12 20;">
            <VBox alignment="CENTER" minWidth="40" minHeight="40"
                  style="-fx-background-color: linear-gradient(to bottom right, #f59e0b, #ea580c); -fx-background-radius: 10;">
                <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;" text="TL"/>
            </VBox>
            <VBox spacing="2">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #111827;" text="Taca Lab"/>
                <Label style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" text="Portal do Cliente"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label fx:id="userNameLabel" style="-fx-font-weight: bold; -fx-text-fill: #111827;" text="Maria Silva"/>
                <Label fx:id="companyLabel" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" text="Restaurante Terra"/>
            </VBox>
            <Button mnemonicParsing="false" onAction="#onLogout" style="-fx-background-color: transparent; -fx-border-color: #d1d5db;" text="Sair"/>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="230" spacing="4"
              style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets top="12" right="10" bottom="12" left="10"/>
            </padding>
            <Button fx:id="dashboardButton" mnemonicParsing="false" onAction="#onDashboard"
                    style="-fx-alignment: center-left; -fx-background-color: transparent; -fx-padding: 10 12;"
                    text="Dashboard"/>
            <Button fx:id="catalogButton" mnemonicParsing="false" onAction="#onCatalog"
                    style="-fx-alignment: center-left; -fx-background-color: transparent; -fx-padding: 10 12;"
                    text="Catalogo"/>
            <Button fx:id="briefingButton" mnemonicParsing="false" onAction="#onBriefing"
                    style="-fx-alignment: center-left; -fx-background-color: transparent; -fx-padding: 10 12;"
                    text="Novo Briefing"/>
            <Button fx:id="projectsButton" mnemonicParsing="false" onAction="#onProjects"
                    style="-fx-alignment: center-left; -fx-background-color: transparent; -fx-padding: 10 12;"
                    text="Meus Projetos"/>
            <Button fx:id="ordersButton" mnemonicParsing="false" onAction="#onOrders"
                    style="-fx-alignment: center-left; -fx-background-color: transparent; -fx-padding: 10 12;"
                    text="Encomendas"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane" style="-fx-padding: 20;"/>
    </center>
</BorderPane>
