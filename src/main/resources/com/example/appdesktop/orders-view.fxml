<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.appdesktop.OrdersController"
            style="-fx-background: transparent; -fx-background-color: transparent;">
    <content>
        <VBox spacing="16" style="-fx-padding: 4;">
            <VBox spacing="4">
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Historico de Encomendas"/>
                <Label style="-fx-text-fill: #4b5563;" text="Acompanhe todas as suas compras do catalogo"/>
            </VBox>

            <TextField fx:id="searchField" onKeyReleased="#onSearchChanged" promptText="Procurar por numero de encomenda ou produto..."/>

            <VBox fx:id="ordersContainer" spacing="12"/>

            <VBox fx:id="emptyState" alignment="CENTER" managed="false" spacing="8" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 10;" visible="false">
                <Label style="-fx-text-fill: #6b7280;" text="Nenhuma encomenda encontrada"/>
                <Button mnemonicParsing="false" onAction="#onExploreCatalog" style="-fx-background-color: transparent; -fx-border-color: #d1d5db;" text="Explorar Catalogo"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
